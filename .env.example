# App
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tenancy (F0): fallback when Host header isn't a registered tenant_domains row
# (localhost, *.vercel.app previews). ?tenant=<slug> also works locally.
DEFAULT_TENANT=gasasteget

# F9-R11: 32-byte AES-256-GCM key (base64), used to encrypt tenant SMTP
# passwords at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SMTP_ENC_KEY=
